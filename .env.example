# ---------------------------------------------------------------- 访问控制
# 打开 App 时输入的密码
APP_PASSWORD=换成你自己的密码
# 会话签名密钥，用 `openssl rand -hex 32` 生成，至少 32 字符
SESSION_SECRET=
# 登录状态保持天数
SESSION_DAYS=30

# ------------------------------------------------------------------ Prowlarr
# 容器内互访用服务名；宿主机直跑时改成 http://127.0.0.1:9696
PROWLARR_URL=http://prowlarr:9696
# Prowlarr → Settings → General → API Key
PROWLARR_API_KEY=

# ------------------------------------------------------- M-Team（馒头，原生接入）
# M-Team 是 JSON API 站，Prowlarr / Jackett 上游都没有它的定义，所以本应用直接对接。
# 令牌获取：登录 M-Team → 控制台 → 实验室 → 存取令牌 → 生成
# 留空即不启用 M-Team。
MTEAM_API_KEY=
# 站点域名。备用域名有 https://zp.m-team.io、https://ob.m-team.cc
# API 地址会自动推导（kp.m-team.cc → api.m-team.cc），不用单独配
MTEAM_URL=https://kp.m-team.cc
# 只有用镜像域名/反代、API 不在 api.<主域> 上时才需要显式指定
MTEAM_API_URL=
# normal=综合区（默认）｜adult=成人区｜all=两者都搜
MTEAM_MODE=normal

# --------------------------------------------------------------- qBittorrent
# 指向你 NAS 上已有的 qBittorrent WebUI
QB_URL=http://192.168.1.10:8080
QB_USERNAME=admin
QB_PASSWORD=
# 留空则依赖 qBittorrent 的「对本机/白名单免认证」设置

# 推送时的默认值，App 里可以逐次覆盖
QB_DEFAULT_CATEGORY=
QB_DEFAULT_TAGS=ptpocket
QB_DEFAULT_SAVEPATH=

# ---------------------------------------------------------------------- 其他
# 单站搜索超时。挂了 FlareSolverr 的站会慢，可以调大
SEARCH_TIMEOUT_MS=45000
SEARCH_LIMIT=100
# 在 Cloudflare Tunnel / nginx 后面部署时保持 true
TRUST_PROXY=true
LOG_LEVEL=info
PORT=8787
HOST=0.0.0.0
# 前端静态资源目录。Docker 镜像里已设为 /app/web-dist；
# 本地开发留空即可（会自动找 web/dist，找不到就只提供 API）
# WEB_DIST=
