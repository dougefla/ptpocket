# ============================ 部署（docker compose 用）============================
# 镜像地址：把 <你的DockerHub用户名> 换掉。
# 必须和 GitHub Actions 里的 DOCKERHUB_USERNAME secret 一致，否则拉不到。
# 如果 Docker Hub 上那个仓库是 private，NAS 上要先 docker login。
PTPOCKET_IMAGE=<你的DockerHub用户名>/ptpocket:latest

# 宿主机端口
PTPOCKET_PORT=8787
PROWLARR_PORT=9696
# 仅当用 --profile qbit 一起启动 qBittorrent 时才生效
QB_PORT=8080

# 配置文件存放位置。写绝对路径，按你的 NAS 来：
#   群晖   /volume1/docker/ptpocket
#   威联通 /share/Container/ptpocket
#   unRAID /mnt/user/appdata/ptpocket
DATA_DIR=./data
# 下载目录，仅 --profile qbit 时用到
DOWNLOADS_DIR=./data/downloads

# 容器内用户。用 `id` 命令查你的实际值，常见默认：
#   群晖   PUID=1026 PGID=100
#   威联通 PUID=1000 PGID=100
#   unRAID PUID=99   PGID=100
#   普通 Linux PUID=1000 PGID=1000
PUID=1000
PGID=1000
TZ=Asia/Shanghai

# ---------------------------------------------------------------- 访问控制
# 打开 App 时输入的密码
APP_PASSWORD=换成你自己的密码
# 会话签名密钥，用 `openssl rand -hex 32` 生成，至少 32 字符
SESSION_SECRET=
# 登录状态保持天数
SESSION_DAYS=30

# ------------------------------------------------------------------ Prowlarr
# 容器内互访用服务名；宿主机直跑时改成 http://127.0.0.1:9696
PROWLARR_URL=http://prowlarr:9696
# Prowlarr → Settings → General → API Key
PROWLARR_API_KEY=

# ------------------------------------------------------- M-Team（馒头，原生接入）
# M-Team 是 JSON API 站，Prowlarr / Jackett 上游都没有它的定义，所以本应用直接对接。
# 令牌获取：登录 M-Team → 控制台 → 实验室 → 存取令牌 → 生成
# 留空即不启用 M-Team。
MTEAM_API_KEY=
# 站点域名。备用域名有 https://zp.m-team.io、https://ob.m-team.cc
# API 地址会自动推导（kp.m-team.cc → api.m-team.cc），不用单独配
MTEAM_URL=https://kp.m-team.cc
# 只有用镜像域名/反代、API 不在 api.<主域> 上时才需要显式指定
MTEAM_API_URL=
# normal=综合区（默认）｜adult=成人区｜all=两者都搜
MTEAM_MODE=normal

# --------------------------------------------------------------- qBittorrent
# 下载器在哪都行 —— 后端会把 .torrent 字节直接上传给它，
# 所以远程下载器**不需要**能访问 PT 站，也不需要 Cookie/passkey。
#
#   1. 远程下载器（独立服务器 / 盒子 / seedbox）
QB_URL=https://qb.example.com
#   2. 同一台 NAS 上已装 qBittorrent → 用 host.docker.internal 访问宿主机端口，
#      不必查内网 IP（compose 已配好 host-gateway）
# QB_URL=http://host.docker.internal:8080
#   3. 用 --profile qbit 和本 compose 一起启动 → 走服务名
# QB_URL=http://qbittorrent:8080

# 远程下载器且使用自签 TLS 证书时才设为 true。
# 开了就等于不防中间人 —— 能用正式证书（Let's Encrypt）或走 VPN 明文访问就别开。
# 连不上时看 App 设置页的报错，会直接告诉你是不是这个原因。
QB_INSECURE_TLS=false
QB_USERNAME=admin
QB_PASSWORD=
# 留空则依赖 qBittorrent 的「对本机/白名单免认证」设置

# 推送时的默认值，App 里可以逐次覆盖
QB_DEFAULT_CATEGORY=
QB_DEFAULT_TAGS=ptpocket
QB_DEFAULT_SAVEPATH=

# ---------------------------------------------------------------------- 其他
# 单站搜索超时。挂了 FlareSolverr 的站会慢，可以调大
SEARCH_TIMEOUT_MS=45000
SEARCH_LIMIT=100
# 在 Cloudflare Tunnel / nginx 后面部署时保持 true
TRUST_PROXY=true
LOG_LEVEL=info
PORT=8787
HOST=0.0.0.0
# 前端静态资源目录。Docker 镜像里已设为 /app/web-dist；
# 本地开发留空即可（会自动找 web/dist，找不到就只提供 API）
# WEB_DIST=
